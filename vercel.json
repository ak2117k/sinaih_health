{
    "version": 2,
    "builds": [
      {
        "src": "./backend/server.js",  
        "use": "@vercel/node",
        "config": {
            "maxDuration": 60
        }
      },
      {
        "src": "./frontend/dist",   
        "use": "@vercel/static"
      }
    ],
    "rewrites": [
      {
        "source": "/(.*)",
        "destination": "/backend/server.js"
      }
    ]
}
